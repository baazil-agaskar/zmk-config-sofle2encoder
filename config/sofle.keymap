#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Encoders

&sensors { triggers-per-rotation = <20>; };

&left_encoder { steps = <5>; };

&right_encoder { steps = <60>; };

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rshift {
            bindings = <&kp RSHIFT>;
            key-positions = <32 31>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <27 33>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <25 41>;
        };

        rcrtl {
            bindings = <&kp RCTRL>;
            key-positions = <19 20>;
        };

        lctrl {
            bindings = <&kp LCTRL>;
            key-positions = <16 15>;
        };

        lshift {
            bindings = <&kp LSHIFT>;
            key-positions = <28 27>;
        };

        renter {
            bindings = <&kp ENTER>;
            key-positions = <45 46>;
        };

        lenter {
            bindings = <&kp ENTER>;
            key-positions = <40 39>;
        };
    };

    behaviors {
        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <POUND MINUS BACKSPACE UNDERSCORE>;
        };

        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 3 14 26 38 50 51 39 27 15 4 5 17 16 28 29 40 41 42 54 53 52>;
            hold-trigger-on-release;
        };

        HMShiftL: HMShiftL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <22 23 31 32 33 34 35 45 46 47 48 49 6 7 8 9 18 19 20 21 30 31 32 33 44 45 46 47 56 57 58 59 10 11 21 22 23 30 31 32 33 43 44 45 46 47 55 56 57 58 59>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-key-positions = <0 12 24 36 37 25 13 1 2 3 14 26 38 50 51 39 27 15 4 5 17 16 28 29 40 41 42 54 53 52>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <22 23 31 32 33 34 35 45 46 47 48 49 6 7 8 9 18 19 20 21 30 31 32 33 44 45 46 47 56 57 58 59 10 11 21 22 23 30 31 32 33 43 44 45 46 47 55 56 57 58 59>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak-DH";
            bindings = <
&gresc          &kp N1  &kp N2          &kp N3    &kp N4    &kp N5                                        &kp N6      &kp N7      &kp N8     &kp N9     &kp N0         &kp AMPERSAND
&kp TAB         &kp Q   &kp W           &kp F     &kp P     &kp B                                         &kp J       &kp L       &kp U      &kp Y      &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp A   &kp R           &kp S     &kp T     &kp G                                         &kp M       &kp N       &kp E      &kp I      &kp O          &kp UNDERSCORE
&kp LCTRL       &kp Z   &kp X           &kp C     &kp D     &kp V      &kp C_MUTE       &kp C_PLAY_PAUSE  &kp K       &kp H       &kp COMMA  &kp DOT    &kp FSLH       &kp RIGHT_SHIFT
                        &kp UNDERSCORE  &kp LALT  &kp LGUI  &mo LOWER  &kp BACKSPACE    &kp SPACE         &tog RAISE  &kp DELETE  &kp RALT   &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT>, <&inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "Navigation";
            bindings = <
&kp TILDE  &kp F1        &kp F2         &kp F3           &kp F4       &kp F5                                  &kp F6                 &kp F7           &kp F8          &kp F9        &kp F10         &kp F11
&trans     &kp LG(LEFT)  &kp LG(RIGHT)  &kp LS(LA(TAB))  &kp LA(TAB)  &kp LEFT_BRACKET                        &kp RIGHT_BRACKET      &kp LS(LC(TAB))  &kp LC(TAB)     &kp N9        &kp UNDERSCORE  &kp F12
&trans     &kp HOME      &kp PAGE_UP    &kp PAGE_DOWN    &kp END      &kp LEFT_PARENTHESIS                    &kp RIGHT_PARENTHESIS  &kp LEFT         &kp DOWN        &kp UP_ARROW  &kp RIGHT       &kp PIPE
&trans     &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LEFT_BRACE        &trans    &trans  &kp RIGHT_BRACE        &msc SCRL_UP     &msc SCRL_DOWN  &kp LA(LEFT)  &kp LA(RIGHT)   &kp BSLH
                         &trans         &trans           &trans       &trans                &trans    &trans  &trans                 &trans           &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        raise_layer {
            display-name = "Symbols";
            bindings = <
&trans  &trans         &trans    &trans      &trans  &trans                       &trans         &kp C_PREV       &kp C_PP  &kp C_NEXT         &trans      &trans
&trans  &kp DELETE     &kp N7    &kp N8      &kp N9  &kp FSLH                     &kp PERCENT    &kp C_VOLUME_UP  &kp UP    &kp C_VOLUME_DOWN  &kp LC(F6)  &trans
&trans  &kp BACKSPACE  &kp N4    &kp N5      &kp N6  &kp ASTRK                    &kp BACKSPACE  &kp LEFT         &kp DOWN  &kp RIGHT          &kp DELETE  &trans
&trans  &kp LC(Z)      &kp N1    &kp N2      &kp N3  &kp CLCK   &trans    &trans  &kp EQUAL      &kp ASTRK        &kp PLUS  &kp MINUS          &kp FSLH    &trans
                       &kp HASH  &kp PERIOD  &kp N0  &trans     &trans    &trans  &trans         &trans           &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Utilites";
            bindings = <
&bt BT_CLR_ALL     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2     &bt BT_SEL 3   &bt BT_SEL 4                      &none        &none         &none         &none          &none          &none
&ext_power EP_TOG  &none          &kp INSERT     &kp LG(UP)       &kp LC(F6)     &studio_unlock                    &none        &none         &kp LG(UP)    &none          &none          &none
&sys_reset         &none          &kp LG(LEFT)   &kp LG(DOWN)     &kp LG(RIGHT)  &none                             &none        &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)  &kp BACKSPACE  &trans
&bootloader        &kp LA(LC(I))  &kp LC(LS(E))  &kp LC(LS(SQT))  &kp LC(SQT)    &caps_word      &none     &none   &kp LS(F10)  &kp LC(N1)    &kp LC(N2)    &kp LC(N3)     &kp LC(N4)     &trans
                                  &kp ENTER      &kp PERIOD       &kp N0         &none           &trans    &trans  &none        &kp DELETE    &none         &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN>,
                <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };
};
