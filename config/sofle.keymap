#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Encoders

&sensors { triggers-per-rotation = <20>; };

&left_encoder { steps = <5>; };

&right_encoder { steps = <60>; };

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rshift {
            bindings = <&kp TAB>;
            key-positions = <31 32>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <40 45>;
        };

        rcrtl {
            bindings = <&kp DEL>;
            key-positions = <19 20>;
        };

        lctrl {
            bindings = <&kp DELETE>;
            key-positions = <16 15>;
        };

        lshift {
            bindings = <&kp TAB>;
            key-positions = <28 27>;
        };

        renter {
            bindings = <&kp ENTER>;
            key-positions = <45 46>;
        };

        lenter {
            bindings = <&kp ENTER>;
            key-positions = <40 39>;
        };
    };

    behaviors {
        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <POUND MINUS BACKSPACE UNDERSCORE>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <190>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 8 7 9 10 11 22 23 34 35 49 48 59 58 57 56 55 43 44 30 18 19 20 21 33 32 31 45 46 47>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            quick-tap-ms = <190>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            hold-trigger-on-release;
        };

        hml_shift: hml_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <200>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <6 8 7 9 10 11 22 23 34 35 49 48 59 58 57 56 55 43 44 30 18 19 20 21 33 32 31 45 46 47>;
        };

        hmr_shift: hmr_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <200>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
        };

        hash_at_tap_dance: hash_at_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "HASH_AT_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp AT>;

            tapping-term-ms = <170>;
        };

        div_tap_dance: div_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "DIV_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp ASTRK>;

            tapping-term-ms = <170>;
        };

        play_pause_tap_dance: play_pause_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "PLAY_PAUSE_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp C_PLAY_PAUSE>;

            tapping-term-ms = <170>;
        };

        minus_underscore_eq_dance: minus_underscore_eq_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "MINUS_UNDERSCORE_EQ_DANCE";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp EQUAL>;

            tapping-term-ms = <170>;
        };

        sqt_dollar_behavior: sqt_dollar_behavior {
            compatible = "zmk,behavior-tap-dance";
            label = "SQT_DOLLAR_BEHAVIOR";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DOLLAR>;

            tapping-term-ms = <170>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak-DH";
            bindings = <
&gresc          &kp N1       &kp N2           &kp N3                   &kp N4               &kp N5                                        &kp N6     &kp N7                &play_pause_tap_dance     &kp N9            &kp N0          &kp EQUAL
&kp TAB         &kp Q        &kp W            &kp F                    &kp P                &kp B                                         &kp J      &kp L                 &kp U                     &kp Y             &kp SEMICOLON   &sqt_dollar_behavior
&kp LEFT_SHIFT  &hml LGUI A  &hml LEFT_ALT R  &hml_shift LEFT_SHIFT S  &hml LEFT_CONTROL T  &kp G                                         &kp M      &hmr RIGHT_CONTROL N  &hmr_shift RIGHT_SHIFT E  &hmr RIGHT_ALT I  &hmr LGUI O     &minus_underscore_eq_dance
&kp LCTRL       &kp Z        &kp X            &kp C                    &kp D                &kp V      &kp C_MUTE       &kp C_PLAY_PAUSE  &kp K      &kp H                 &kp COMMA                 &kp DOT           &div_tap_dance  &hash_at_tap_dance
                             &kp ASTRK        &kp LALT                 &kp LGUI             &mo LOWER  &kp BACKSPACE    &kp SPACE         &mo RAISE  &kp DELETE            &kp RALT                  &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT>, <&inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "Navigation";
            bindings = <
&trans  &kp F1        &kp F2         &kp F3       &kp F4            &kp F5                               &kp F6  &kp F7        &kp F8        &kp F9           &kp F10        &kp F11
&trans  &kp EXCL      &kp AT         &kp HASH     &kp DOLLAR        &kp PERCENT                          &none   &kp LA(LEFT)  &kp LC(TAB)   &kp LC(LS(TAB))  &kp LA(RIGHT)  &kp F12
&trans  &kp LC(DOWN)  &kp PAGE_DOWN  &kp PAGE_UP  &kp LC(UP)        &none                                &none   &kp LEFT      &kp DOWN      &kp UP_ARROW     &kp RIGHT      &trans
&trans  &kp CARET     &kp AMPERSAND  &kp ASTRK    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans    &trans  &none   &kp LC(LEFT)  &kp LC(HOME)  &kp END          &kp LC(RIGHT)  &trans
                      &trans         &trans       &trans            &trans             &trans    &trans  &trans  &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        raise_layer {
            display-name = "Symbols";
            bindings = <
&trans                &trans         &trans         &trans      &trans  &trans                                         &trans       &trans         &trans         &trans            &trans     &trans
&kp LEFT_BRACKET      &kp BACKSPACE  &kp N7         &kp N8      &kp N9  &kp RIGHT_BRACKET                              &kp EQUAL    &kp ASTERISK   &kp MINUS      &kp PLUS          &kp FSLH   &kp TILDE
&kp LEFT_PARENTHESIS  &kp PERIOD     &kp N4         &kp N5      &kp N6  &kp RIGHT_PARENTHESIS                          &kp PERCENT  &kp LEFT       &kp DOWN       &kp UP            &kp RIGHT  &kp CARET
&kp LEFT_BRACE        &kp N0         &kp N1         &kp N2      &kp N3  &kp RIGHT_BRACE        &kp CAPSLOCK    &trans  &kp EXCL     &kp AMPERSAND  &kp LESS_THAN  &kp GREATER_THAN  &kp BSLH   &kp PIPE
                                     &kp BACKSPACE  &kp PERIOD  &kp N0  &trans                 &trans          &trans  &trans       &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Utilites";
            bindings = <
&bt BT_CLR_ALL     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2     &bt BT_SEL 3   &bt BT_SEL 4                      &none        &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT         &none       &none
&ext_power EP_TOG  &none          &kp INSERT     &kp LG(UP)       &kp LC(F6)     &studio_unlock                    &none        &kp C_VOLUME_UP  &kp LG(UP)        &kp C_VOLUME_DOWN  &none       &none
&sys_reset         &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(UP)       &kp LG(RIGHT)  &mkp LCLK                         &kp LS(F10)  &kp LA(N1)       &kp LA(N2)        &kp LA(N3)         &kp LA(N4)  &trans
&bootloader        &kp LA(LC(I))  &kp LC(LS(E))  &kp LC(LS(SQT))  &kp LC(SQT)    &caps_word      &none     &none   &kp CAPS     &kp LC(N1)       &kp LC(N2)        &kp LC(N3)         &kp LC(N4)  &trans
                                  &trans         &trans           &trans         &none           &trans    &trans  &none        &trans           &trans            &trans
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN>,
                <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };
};
